generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationTypeCode {
  CLINIC
  UNIVERSITY
  RESEARCH_INSTITUTE
  FARM
  GOVERNMENT
  LABORATORY
  MANUFACTURER
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
enum UserStatus {
  PENDING_INVITATION
  ACTIVE
  SUSPENDED
  INACTIVE
  LOCKED
}
enum EmploymentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ON_LEAVE
  RESIGNED
  TERMINATED
}
enum PartyType {
  INDIVIDUAL
  FARM
  COMPANY
  UNIVERSITY
  LABORATORY
  GOVERNMENT
  MANUFACTURER
  OTHER
}
enum PartyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}
enum AnimalStatus {
  ACTIVE
  DECEASED
  TRANSFERRED
  LOST
  ARCHIVED
}
enum AnimalSex {
  MALE
  FEMALE
  UNKNOWN
}
enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum AppointmentType {
  CONSULTATION
  VACCINATION
  SURGERY
  FOLLOW_UP
  EMERGENCY
  OTHER
}
enum MedicalRecordStatus {
  DRAFT
  FINAL
  AMENDED
}
enum PrescriptionStatus {
  ACTIVE
  DISPENSED
  COMPLETED
  CANCELLED
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}
enum BillStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}
enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  E_WALLET
  OTHER
}
enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  DISPENSE
  TRANSFER
}
enum DocumentType {
  RESEARCH_PAPER
  CLINICAL_CASE
  JOURNAL
  CONFERENCE_MATERIAL
  THESIS
  GOVERNMENT_PUBLICATION
  VIDEO
  OTHER
}
enum EvidenceVisibility {
  PUBLIC
  ORGANIZATION_ONLY
  RESTRICTED
}
enum ClinicalCaseStatus {
  DRAFT
  REVIEWED
  PUBLISHED
  ARCHIVED
}
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}
enum SubscriptionPlanCode {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
  INVITE
  ACTIVATE
  SUSPEND
}

model User {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  firstName          String           @db.VarChar(100)
  lastName           String           @db.VarChar(100)
  email              String           @db.VarChar(320)
  mobile             String?          @db.VarChar(30)
  employeeNumber     String?          @db.VarChar(50)
  jobTitle           String?          @db.VarChar(150)
  hireDate           DateTime?        @db.Date
  employmentStatus   EmploymentStatus?
  employmentTypeId   String?          @db.Uuid
  status             UserStatus       @default(PENDING_INVITATION)
  passwordHash       String?
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employmentType     EmploymentType?  @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  roles              UserRole[]
  branches           UserBranch[]
  departments        UserDepartment[]
  invitations        UserInvitation[]
  sessions           UserSession[]
  passwordResets     PasswordReset[]
  createdRecords     MedicalRecord[]  @relation("RecordCreatedBy")
  appointments       Appointment[]    @relation("AssignedUser")
  auditLogs          AuditLog[]
  portalAccount      PortalAccount?

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
}

model EmploymentType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  active    Boolean  @default(true)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("employment_types")
}

model OrganizationType {
  id            String               @id @default(uuid()) @db.Uuid
  code          OrganizationTypeCode @unique
  name          String               @db.VarChar(100)
  organizations Organization[]
  @@map("organization_types")
}

model Organization {
  id             String             @id @default(uuid()) @db.Uuid
  typeId         String             @db.Uuid
  name           String             @db.VarChar(255)
  code           String             @unique @db.VarChar(50)
  status         OrganizationStatus @default(ACTIVE)
  email          String?            @db.VarChar(320)
  phone          String?            @db.VarChar(30)
  address        String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  type           OrganizationType   @relation(fields: [typeId], references: [id])
  branches       Branch[]
  departments    Department[]
  users          User[]
  parties        Party[]
  products       Product[]
  suppliers      Supplier[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  subscriptions  Subscription[]
  websites       OrganizationWebsite[]
  auditLogs      AuditLog[]
  roles          Role[]
  clinicalCases  ClinicalCase[]

  @@index([typeId, status])
  @@map("organizations")
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  name         String       @db.VarChar(150)
  code         String       @db.VarChar(50)
  address      String?
  phone        String?      @db.VarChar(30)
  active       Boolean      @default(true)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        UserBranch[]
  departments  Department[]
  appointments Appointment[]
  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("branches")
}

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  branchId       String?      @db.Uuid
  name           String       @db.VarChar(150)
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  users          UserDepartment[]
  @@unique([organizationId, name])
  @@map("departments")
}

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @db.Uuid
  name           String       @db.VarChar(100)
  description    String?
  systemRole     Boolean      @default(false)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  users          UserRole[]
  @@unique([organizationId, name])
  @@map("roles")
}

model PermissionGroup {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(100)
  permissions Permission[]
  @@map("permission_groups")
}

model Permission {
  id          String          @id @default(uuid()) @db.Uuid
  groupId     String?         @db.Uuid
  code        String          @unique @db.VarChar(150)
  description String?
  group       PermissionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  roles       RolePermission[]
  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
  @@map("user_roles")
}

model UserBranch {
  userId   String @db.Uuid
  branchId String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@id([userId, branchId])
  @@map("user_branches")
}

model UserDepartment {
  userId       String     @db.Uuid
  departmentId String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  @@id([userId, departmentId])
  @@map("user_departments")
}

model UserInvitation {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("user_invitations")
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  tokenHash    String   @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime?
  ipAddress    String?  @db.VarChar(64)
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model PasswordReset {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("password_resets")
}

model Party {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  partyType      PartyType
  name           String       @db.VarChar(255)
  email          String?      @db.VarChar(320)
  contactNo      String?      @db.VarChar(30)
  address        String?
  status         PartyStatus  @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm           Farm?
  animals        Animal[]
  appointments   Appointment[]
  invoices       ArInvoice[]
  @@index([organizationId, partyType, status])
  @@index([organizationId, name])
  @@map("parties")
}

model Farm {
  id          String   @id @default(uuid()) @db.Uuid
  partyId     String   @unique @db.Uuid
  farmName    String   @db.VarChar(255)
  farmOwner   String   @db.VarChar(255)
  address     String?
  contactNo   String?  @db.VarChar(30)
  farmType    String   @db.VarChar(100)
  farmSize    Decimal? @db.Decimal(14, 2)
  farmSizeUnit String? @db.VarChar(30)
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  @@index([farmType])
  @@map("farms")
}

model Animal {
  id             String      @id @default(uuid()) @db.Uuid
  partyId        String       @db.Uuid
  name           String       @db.VarChar(150)
  species        String       @db.VarChar(100)
  breed          String?      @db.VarChar(100)
  sex            AnimalSex    @default(UNKNOWN)
  birthDate      DateTime?    @db.Date
  identificationNo String?    @db.VarChar(100)
  status         AnimalStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  party          Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  vaccinations   Vaccination[]
  clinicalCases  ClinicalCase[]
  @@index([partyId, status])
  @@index([identificationNo])
  @@map("animals")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  branchId       String?           @db.Uuid
  partyId        String            @db.Uuid
  animalId       String            @db.Uuid
  assignedUserId String?           @db.Uuid
  type           AppointmentType
  status         AppointmentStatus @default(REQUESTED)
  scheduledAt    DateTime
  reason         String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  party          Party             @relation(fields: [partyId], references: [id], onDelete: Restrict)
  animal         Animal            @relation(fields: [animalId], references: [id], onDelete: Restrict)
  assignedUser   User?             @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  @@index([organizationId, scheduledAt])
  @@index([animalId, scheduledAt])
  @@map("appointments")
}

model MedicalRecord {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  animalId       String              @db.Uuid
  createdById    String              @db.Uuid
  appointmentId  String?             @db.Uuid
  status         MedicalRecordStatus  @default(DRAFT)
  visitDate      DateTime             @default(now())
  chiefComplaint String?
  diagnosisNotes String?
  treatmentNotes String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  animal         Animal               @relation(fields: [animalId], references: [id], onDelete: Restrict)
  createdBy      User                 @relation("RecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  soap           SoapNote?
  prescriptions  Prescription[]
  vaccinations   Vaccination[]
  labResults     LabResult[]
  surgeries      Surgery[]
  attachments    MedicalAttachment[]
  @@index([organizationId, visitDate])
  @@index([animalId, visitDate])
  @@map("medical_records")
}

model SoapNote {
  id             String        @id @default(uuid()) @db.Uuid
  medicalRecordId String        @unique @db.Uuid
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  medicalRecord  MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  @@map("soap_notes")
}

model Prescription {
  id             String           @id @default(uuid()) @db.Uuid
  medicalRecordId String           @db.Uuid
  animalId       String           @db.Uuid
  productId      String?          @db.Uuid
  medicationName String           @db.VarChar(255)
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?
  status         PrescriptionStatus @default(ACTIVE)
  prescribedAt   DateTime         @default(now())
  medicalRecord  MedicalRecord    @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  animal         Animal           @relation(fields: [animalId], references: [id], onDelete: Restrict)
  product        Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([animalId, status])
  @@map("prescriptions")
}

model Vaccination {
  id             String        @id @default(uuid()) @db.Uuid
  medicalRecordId String       @db.Uuid
  animalId       String        @db.Uuid
  vaccineName    String        @db.VarChar(255)
  administeredAt DateTime
  nextDueAt      DateTime?
  notes          String?
  medicalRecord  MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  animal         Animal        @relation(fields: [animalId], references: [id], onDelete: Restrict)
  @@index([animalId, administeredAt])
  @@map("vaccinations")
}

model LabResult {
  id             String        @id @default(uuid()) @db.Uuid
  medicalRecordId String       @db.Uuid
  testName       String        @db.VarChar(255)
  result         String?
  referenceRange String?
  performedAt    DateTime?
  attachmentUrl  String?
  medicalRecord  MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  @@map("lab_results")
}

model Surgery {
  id             String        @id @default(uuid()) @db.Uuid
  medicalRecordId String       @db.Uuid
  procedureName  String        @db.VarChar(255)
  performedAt    DateTime
  surgeonNotes   String?
  outcome        String?
  medicalRecord  MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  @@map("surgeries")
}

model MedicalAttachment {
  id             String        @id @default(uuid()) @db.Uuid
  medicalRecordId String       @db.Uuid
  fileName       String        @db.VarChar(255)
  fileUrl        String
  mimeType       String?       @db.VarChar(100)
  createdAt      DateTime      @default(now())
  medicalRecord  MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  @@map("medical_attachments")
}

model ProductCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(150)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  @@unique([organizationId, name])
  @@map("product_categories")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  categoryId     String?         @db.Uuid
  sku            String          @db.VarChar(100)
  name           String          @db.VarChar(255)
  unit           String?         @db.VarChar(50)
  salePrice      Decimal?        @db.Decimal(14, 2)
  costPrice      Decimal?        @db.Decimal(14, 2)
  active         Boolean         @default(true)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements     InventoryMovement[]
  saleItems     SaleItem[]
  prescription  Prescription[]
  billItems     ApBillItem[]
  @@unique([organizationId, sku])
  @@index([organizationId, active])
  @@map("products")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  productId      String                @db.Uuid
  movementType   InventoryMovementType
  quantity       Decimal               @db.Decimal(14, 3)
  referenceType  String?               @db.VarChar(50)
  referenceId    String?               @db.Uuid
  occurredAt     DateTime              @default(now())
  notes          String?
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([organizationId, productId, occurredAt])
  @@map("inventory_movements")
}

model Supplier {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(255)
  contactNo      String?      @db.VarChar(30)
  email          String?      @db.VarChar(320)
  address        String?
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bills          ApBill[]
  @@unique([organizationId, name])
  @@map("suppliers")
}

model Sale {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  partyId        String?      @db.Uuid
  saleNumber     String       @db.VarChar(50)
  soldAt         DateTime     @default(now())
  totalAmount    Decimal      @db.Decimal(14, 2)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          SaleItem[]
  payments       Payment[]
  @@unique([organizationId, saleNumber])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @db.Uuid
  productId   String?  @db.Uuid
  description String   @db.VarChar(255)
  quantity    Decimal  @db.Decimal(14, 3)
  unitPrice   Decimal  @db.Decimal(14, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@map("sale_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  saleId         String?       @db.Uuid
  arInvoiceId    String?       @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  referenceNo    String?       @db.VarChar(100)
  paidAt         DateTime      @default(now())
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  arInvoice      ArInvoice?    @relation(fields: [arInvoiceId], references: [id], onDelete: SetNull)
  @@index([arInvoiceId, paidAt])
  @@map("payments")
}

model Expense {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  category       String       @db.VarChar(100)
  description    String
  amount         Decimal      @db.Decimal(14, 2)
  incurredAt     DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, incurredAt])
  @@map("expenses")
}

model ArInvoice {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  partyId        String       @db.Uuid
  invoiceNumber  String       @db.VarChar(50)
  status         InvoiceStatus @default(ISSUED)
  issuedAt       DateTime     @default(now())
  dueAt          DateTime?
  totalAmount    Decimal      @db.Decimal(14, 2)
  balance        Decimal      @db.Decimal(14, 2)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  party          Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  items          ArInvoiceItem[]
  payments       Payment[]
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueAt])
  @@map("ar_invoices")
}

model ArInvoiceItem {
  id          String    @id @default(uuid()) @db.Uuid
  invoiceId   String    @db.Uuid
  description String    @db.VarChar(255)
  quantity    Decimal   @db.Decimal(14, 3)
  unitPrice   Decimal   @db.Decimal(14, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)
  invoice     ArInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@map("ar_invoice_items")
}

model ApBill {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  supplierId     String       @db.Uuid
  billNumber     String       @db.VarChar(50)
  status         BillStatus   @default(ISSUED)
  issuedAt       DateTime     @default(now())
  dueAt          DateTime?
  totalAmount    Decimal      @db.Decimal(14, 2)
  balance        Decimal      @db.Decimal(14, 2)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          ApBillItem[]
  payments       ApPayment[]
  @@unique([organizationId, billNumber])
  @@index([organizationId, status, dueAt])
  @@map("ap_bills")
}

model ApBillItem {
  id          String   @id @default(uuid()) @db.Uuid
  billId      String   @db.Uuid
  productId   String?  @db.Uuid
  description String   @db.VarChar(255)
  quantity    Decimal  @db.Decimal(14, 3)
  unitCost    Decimal  @db.Decimal(14, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  bill        ApBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@map("ap_bill_items")
}

model ApPayment {
  id          String        @id @default(uuid()) @db.Uuid
  billId      String        @db.Uuid
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  referenceNo String?       @db.VarChar(100)
  paidAt      DateTime      @default(now())
  bill        ApBill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  @@index([billId, paidAt])
  @@map("ap_payments")
}

model KnowledgeSource {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String?            @db.Uuid
  name           String             @db.VarChar(255)
  publisher      String?
  sourceUrl      String?
  visibility     EvidenceVisibility @default(PUBLIC)
  createdAt      DateTime           @default(now())
  documents      KnowledgeDocument[]
  @@index([visibility])
  @@map("knowledge_sources")
}

model KnowledgeDocument {
  id             String             @id @default(uuid()) @db.Uuid
  sourceId       String             @db.Uuid
  title          String             @db.VarChar(500)
  documentType   DocumentType
  fileUrl        String?
  contentHash    String?            @unique
  extractedText  String?
  language       String?            @db.VarChar(20)
  publishedAt    DateTime?
  visibility     EvidenceVisibility  @default(PUBLIC)
  createdAt      DateTime            @default(now())
  source         KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tags           KnowledgeDocumentTag[]
  references     KnowledgeReference[]
  @@index([documentType, visibility])
  @@map("knowledge_documents")
}

model KnowledgeCategory {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique @db.VarChar(150)
  description String?
  @@map("knowledge_categories")
}

model KnowledgeTag {
  id        String @id @default(uuid()) @db.Uuid
  name      String @unique @db.VarChar(100)
  documents KnowledgeDocumentTag[]
  @@map("knowledge_tags")
}

model KnowledgeDocumentTag {
  documentId String           @db.Uuid
  tagId      String           @db.Uuid
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        KnowledgeTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([documentId, tagId])
  @@map("knowledge_document_tags")
}

model KnowledgeReference {
  id         String           @id @default(uuid()) @db.Uuid
  documentId String           @db.Uuid
  label      String           @db.VarChar(255)
  url        String?
  page       String?          @db.VarChar(50)
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@map("knowledge_references")
}

model ClinicalCase {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  animalId       String?           @db.Uuid
  title          String            @db.VarChar(500)
  summary        String?
  symptoms       String?
  findings       String?
  outcome        String?
  status         ClinicalCaseStatus @default(DRAFT)
  anonymized     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  animal         Animal?           @relation(fields: [animalId], references: [id], onDelete: SetNull)
  @@index([organizationId, status])
  @@map("clinical_cases")
}

model PortalAccount {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications   PortalNotification[]
  @@map("portal_accounts")
}

model PortalNotification {
  id              String        @id @default(uuid()) @db.Uuid
  portalAccountId String        @db.Uuid
  title           String        @db.VarChar(255)
  message         String
  readAt          DateTime?
  createdAt       DateTime      @default(now())
  account         PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  @@index([portalAccountId, readAt])
  @@map("portal_notifications")
}

model OrganizationWebsite {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  domain         String?      @unique @db.VarChar(255)
  title          String       @db.VarChar(255)
  active         Boolean      @default(false)
  settingsJson   Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pages          WebsitePage[]
  media          WebsiteMedia[]
  @@unique([organizationId, title])
  @@map("organization_websites")
}

model WebsitePage {
  id        String             @id @default(uuid()) @db.Uuid
  websiteId String             @db.Uuid
  slug      String             @db.VarChar(150)
  title     String             @db.VarChar(255)
  content   Json?
  published Boolean            @default(false)
  website   OrganizationWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  @@unique([websiteId, slug])
  @@map("website_pages")
}

model WebsiteMedia {
  id        String             @id @default(uuid()) @db.Uuid
  websiteId String             @db.Uuid
  fileName  String             @db.VarChar(255)
  fileUrl   String
  mimeType  String?            @db.VarChar(100)
  website   OrganizationWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  @@map("website_media")
}

model SubscriptionPlan {
  id             String             @id @default(uuid()) @db.Uuid
  code           SubscriptionPlanCode @unique
  name           String             @db.VarChar(100)
  maxUsers       Int?
  maxBranches    Int?
  maxStorageMb   Int?
  aiSearchLimit  Int?
  subscriptions  Subscription[]
  @@map("subscription_plans")
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  planId         String             @db.Uuid
  status         SubscriptionStatus @default(TRIAL)
  startsAt       DateTime
  endsAt         DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id])
  @@index([organizationId, status])
  @@map("subscriptions")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @db.Uuid
  userId         String?      @db.Uuid
  action         AuditAction
  entityType     String       @db.VarChar(100)
  entityId       String?      @db.Uuid
  metadata       Json?
  ipAddress      String?      @db.VarChar(64)
  createdAt      DateTime     @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
